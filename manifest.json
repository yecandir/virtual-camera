{
  "manifest_version": 3,
  "name": "Sanal Kamera",
  "version": "1.0",
  "description": "Kamera yerine video oynat veya gerçek kamerayı kullan.",
  "permissions": ["storage", "unlimitedStorage"],
  "action": { "default_popup": "popup.html", "default_title": "Sanal Kamera" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ]
}
